# Copia questo file in .env e inserisci la tua chiave.
# .env è in .gitignore: non va mai committato.

# Chiave API di CurseForge (console.curseforge.com).
# Va tra apici SINGOLI: le chiavi hanno la forma $2a$10$..., e senza apici (o con apici
# doppi) il lettore di .env tratta ogni $ come una variabile e la chiave si rompe.
CURSEFORGE_API_KEY=''

# Chiave API di Wago Addons (addons.wago.io/account/apikeys), per la fonte Wago (in arrivo).
# Il backend non la legge ancora. Stessa regola degli apici singoli.
WAGO_API_KEY=''
