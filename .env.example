# Copy this file to .env and fill in your key.
# .env is in .gitignore: it must never be committed.

# CurseForge API key (console.curseforge.com).
# It goes in SINGLE quotes: keys have the form $2a$10$..., and without quotes (or with double
# quotes) the .env reader treats every $ as a variable and the key breaks.
CURSEFORGE_API_KEY=''

# Wago Addons API key, for the possible Wago source (D39, awaiting Wago's reply).
# The backend does not read it yet. Same single-quote rule.
WAGO_API_KEY=''
