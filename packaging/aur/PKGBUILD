source=("$url/releases/download/v$pkgver/wow-don_${pkgver}_amd64.deb")
sha256sums=('6c3841b68ce39eaadf55013cc3191b953a5b214c97ad9d7e38e15c4ef769b7d7')

package() {
  bsdtar -xf "$srcdir/data.tar."* -C "$pkgdir"
}
