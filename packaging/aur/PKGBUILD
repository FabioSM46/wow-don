pkgrel=1
pkgdesc='World of Warcraft addon manager for Linux, Windows and macOS'
arch=('x86_64')
url='https://github.com/FabioSM46/wow-don'
license=('GPL-3.0-or-later')
depends=('gtk3' 'libayatana-appindicator' 'webkit2gtk-4.1')
provides=('wow-don')
